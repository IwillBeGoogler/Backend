# Production settings. Copy to .env.prod (chmod 600, never commit) and replace every CHANGE_ME.
# Run:  docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# The API refuses to start in production with a missing, short or dev-default secret (Backend/config/config.go).
# Use hex output (openssl rand -hex N) so values stay safe inside URLs.

# ---- public names (DNS A/AAAA records of both must point at this server) ----
DOMAIN=iwillbegoogler.uz
ADMIN_DOMAIN=admin.iwillbegoogler.uz
ACME_EMAIL=CHANGE_ME                # Let's Encrypt expiry notices
# Space separated CIDRs allowed to open the admin panel; default is anyone.
#ADMIN_ALLOW_CIDRS=203.0.113.7/32 2001:db8::/48
IMAGE_TAG=prod                            # set to a git sha / version per release, for rollbacks
SITE_NAME=IWillBeGoogler

# ---- secrets (generate each one; never reuse) ----
POSTGRES_PASSWORD=CHANGE_ME               # openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME                  # openssl rand -hex 24
S3_ACCESS_KEY=CHANGE_ME                   # openssl rand -hex 10   (MinIO root user, also the API's key)
S3_SECRET_KEY=CHANGE_ME                   # openssl rand -hex 24
S3_BUCKET=uploads
MFA_KEY=CHANGE_ME                         # openssl rand -hex 32   encrypts 2FA secrets; changing it disables existing 2FA
UNSUBSCRIBE_KEY=CHANGE_ME                 # openssl rand -hex 32   (>= 32 chars; empty = derived from MFA_KEY)
AUDIT_EMAIL_KEY=CHANGE_ME                 # openssl rand -hex 32   (hex, >= 32 bytes)
MQTT_PASSWORD=CHANGE_ME                   # openssl rand -hex 32   the API's own broker login
MQTT_INTERNAL_SECRET=CHANGE_ME            # openssl rand -hex 32   bearer EMQX sends to /api/internal/mqtt/*
EMQX_NODE_COOKIE=CHANGE_ME                # openssl rand -hex 32   Erlang node cookie
EMQX_API_SECRET=CHANGE_ME                 # openssl rand -hex 32   the API's key for the broker's REST API (kicks revoked clients)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME          # openssl rand -hex 24   only used with --profile monitoring
METRICS_TOKEN=CHANGE_ME                   # openssl rand -hex 32   bearer for GET https://$DOMAIN/metrics

# 1 = the host nginx owns 80/443 (deploy/server/nginx.sh) and forwards to Caddy on 127.0.0.1:8088.
#BEHIND_NGINX=1

# ---- host datastores (deploy/server/datastores.sh, systemd; not containers) ----
# POSTGRES_PASSWORD / REDIS_PASSWORD above are their passwords. seed-from-env.sh derives DATABASE_URL and REDIS_URL
# (host 172.30.0.1 = gateway of the docker network iwillbegoogler) unless you set them here.
#HOST_GATEWAY=172.30.0.1
# Optional MongoDB (MONGO=1 datastores.sh); root user, auth on. openssl rand -hex 24
#MONGO_ROOT_PASSWORD=CHANGE_ME

# ---- first super admin (created on first start) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME                  # openssl rand -base64 24   (>= 12 chars; change it in the UI afterwards)

# ---- Cloudflare Turnstile CAPTCHA on signup (both or neither; empty disables) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---- Social login (a provider is on only when both its id and secret are set) ----
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application).
#   Authorized redirect URI: https://<DOMAIN>/api/auth/oauth/google/callback
# GitHub: github.com/settings/developers -> New OAuth App.
#   Authorization callback URL: https://<DOMAIN>/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- mail ----
# The API speaks SMTP AUTH + TLS itself, so the postfix relay (smtp-relay) is OPTIONAL.
# Option A (direct, no relay container): point the API at your provider.
MAIL_FROM=no-reply@iwillbegoogler.uz
#SMTP_ADDR=smtp.example.com:587          # SES / Mailgun / Postmark / Brevo ...
#SMTP_TLS=starttls                       # none | starttls (587, required) | tls (465, implicit)
#SMTP_USERNAME=CHANGE_ME
#SMTP_PASSWORD=CHANGE_ME
# Option B (default, legacy): the stack's postfix relay logs in to your provider; the API talks plain SMTP to it.
#SMTP_ADDR=smtp-relay:587                 # default
SMTP_RELAYHOST=[smtp.example.com]:587     # only used by the smtp-relay container
SMTP_RELAY_USERNAME=CHANGE_ME
SMTP_RELAY_PASSWORD=CHANGE_ME
#SMTP_SENDER_DOMAINS=iwillbegoogler.uz          # default: DOMAIN; set the domain used in MAIL_FROM. Add SPF/DKIM/DMARC DNS.
# Either way, set SPF/DKIM/DMARC on the sender domain.

# ---- optional app settings ----
#DOCS_KEY=                                # API console (/docs) in production only when set
#ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]   # TURN for audio rooms
#OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- backups (pgbackup service; local dumps always, upload when BACKUP_S3_BUCKET is set) ----
BACKUP_HOUR_UTC=3
BACKUP_KEEP_DAYS=14
BACKUP_RUN_NOW=0                          # 1 = also dump once at container start
#BACKUP_S3_BUCKET=my-offsite-bucket
#BACKUP_S3_PROVIDER=Cloudflare            # AWS | Cloudflare | Backblaze | Minio | Other
#BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#BACKUP_S3_REGION=
#BACKUP_S3_ACCESS_KEY=
#BACKUP_S3_SECRET_KEY=
#BACKUP_S3_PREFIX=iwillbegoogler/postgres
# blob mirror: copies the S3_BUCKET objects (blog uploads, diagram blobs) offsite; needs BACKUP_S3_BUCKET
#BACKUP_MIRROR=1
#BACKUP_MIRROR_SRC_ENDPOINT=http://minio:9000
#BACKUP_MIRROR_PREFIX=iwillbegoogler/objects

# ---- images (server pulls; local build fallback: IMAGE_REGISTRY=local ... up -d --build, see deploy/README.md) ----
#IMAGE_REGISTRY=docker.io/bakhod1r
# Per-service tags override IMAGE_TAG (CD writes them to $DEPLOY_DIR/tags.env): TAG_WEB, TAG_ADMIN, TAG_API (api+worker+migrate)
#TAG_WEB=
#TAG_ADMIN=
#TAG_API=
