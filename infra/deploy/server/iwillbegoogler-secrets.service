[Unit]
Description=Render IWillBeGoogler secrets from Vault into /run/iwillbegoogler (tmpfs)
Wants=network-online.target
After=network-online.target
# Containers restart with dockerd (restart: unless-stopped) and need the secret_id file first.
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/iwillbegoogler-secrets render
Restart=on-failure
RestartSec=30
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
