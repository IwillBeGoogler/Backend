#!/bin/bash
# Server-side secrets helper (installed to /usr/local/sbin, run as root).
#   accept < wrapped-token[\nrole_id]   unwrap secret_id, store it encrypted (systemd-creds, TPM2 when present), then render
#   render                              decrypt secret_id ->
#                                         /run/iwillbegoogler/secrets/vault_secret_id (tmpfs, 0400, uid APP_UID): the Go
#                                           services log in to Vault themselves and keep their secrets in memory only;
#                                         AppRole login -> read KV -> /run/iwillbegoogler/env (tmpfs, 0400, DEPLOY_USER): compose
#                                           interpolation for the third-party containers (minio, emqx, ...) -> revoke token
#   status                              where the secret_id is kept and which key protects it
# Config: /etc/iwillbegoogler/secrets.conf (VAULT_ADDR, KV_PATH, DEPLOY_USER, optional VAULT_CACERT, CREDS_KEY, APP_UID).
set -euo pipefail
umask 077
CONF=${IWBG_CONF:-/etc/iwillbegoogler/secrets.conf}
# shellcheck source=/dev/null
. "$CONF"
: "${VAULT_ADDR:?}" "${KV_PATH:?}" "${DEPLOY_USER:?}"
CREDS_KEY=${CREDS_KEY:-auto} # host+tpm2 (TPM present) | host (no TPM) | tpm2 | auto
APP_UID=${APP_UID:-65532}    # distroless nonroot
STATE=/etc/iwillbegoogler
CRED=$STATE/secret_id.cred
ROLE_FILE=$STATE/role_id
OUT_DIR=/run/iwillbegoogler
SEC_DIR=$OUT_DIR/secrets
CNAME=iwillbegoogler-secret-id
CA=()
[ -n "${VAULT_CACERT:-}" ] && CA=(--cacert "$VAULT_CACERT")
TOK=""

die() { echo "iwillbegoogler-secrets: $*" >&2; exit 1; }

# vapi METHOD PATH [curl args]; token goes via stdin config, never argv
vapi() {
	local m=$1 p=$2
	shift 2
	printf 'header = "X-Vault-Token: %s"\n' "$TOK" |
		curl -fsS -K - --max-time 20 "${CA[@]}" -X "$m" "$@" "$VAULT_ADDR/v1/$p"
}

revoke() { [ -n "$TOK" ] && vapi POST auth/token/revoke-self >/dev/null 2>&1 || true; TOK=""; }

# install_file SRC DEST OWNER MODE: atomic replace inside the destination dir
install_file() {
	local tmp
	tmp=$(mktemp "$(dirname "$2")/.tmp.XXXXXX")
	cat "$1" >"$tmp"
	chown "$3" "$tmp"
	chmod "$4" "$tmp"
	mv -f "$tmp" "$2"
}

accept() {
	local wrapped role_id
	IFS= read -r wrapped || true
	IFS= read -r role_id || true
	[ -n "$wrapped" ] || die "no wrapped token on stdin"
	if [ -n "$role_id" ]; then printf '%s\n' "$role_id" >"$ROLE_FILE"; fi
	TOK=$wrapped
	local sid
	sid=$(vapi POST sys/wrapping/unwrap | jq -er '.data.secret_id') || die "unwrap failed (expired or already used: treat as compromise)"
	TOK=""
	printf '%s' "$sid" | systemd-creds encrypt --name="$CNAME" --with-key="$CREDS_KEY" - "$CRED.tmp"
	mv -f "$CRED.tmp" "$CRED"
	render
}

render() {
	[ -r "$CRED" ] && [ -r "$ROLE_FILE" ] || die "missing $CRED or $ROLE_FILE (run a deploy first)"
	local sid role_id
	sid=$(systemd-creds decrypt --name="$CNAME" "$CRED" -)
	role_id=$(<"$ROLE_FILE")

	# 1. secret_id for the Go services (they read Vault themselves)
	install -d -m 0711 "$OUT_DIR"
	install -d -m 0711 "$SEC_DIR"
	install_file <(printf '%s' "$sid") "$SEC_DIR/vault_secret_id" "$APP_UID" 0400
	local ca_line=""
	if [ -n "${VAULT_CACERT:-}" ]; then
		install_file "$VAULT_CACERT" "$SEC_DIR/vault-ca.pem" "$APP_UID" 0444
		ca_line="VAULT_CACERT_PATH='$SEC_DIR/vault-ca.pem'"
	fi

	# 2. compose env for the containers that cannot talk to Vault
	TOK=$(jq -n --arg r "$role_id" --arg s "$sid" '{role_id:$r,secret_id:$s}' |
		curl -fsS --max-time 20 "${CA[@]}" --data-binary @- "$VAULT_ADDR/v1/auth/approle/login" |
		jq -er '.auth.client_token') || die "AppRole login failed"
	sid=""
	trap revoke EXIT

	local mount=${KV_PATH%%/*} rest=${KV_PATH#*/} data
	data=$(vapi GET "$mount/data/$rest" | jq -c '.data.data') || die "KV read failed"
	# compose dotenv: single-quoted values are literal, so reject keys/values it cannot represent
	printf '%s' "$data" | jq -e --arg q "'" 'type=="object" and all(to_entries[]; (.key|test("^[A-Z][A-Z0-9_]*$")) and ((.value|tostring)|test("[" + $q + "\\n]")|not))' >/dev/null ||
		die "KV has bad key or value containing ' or newline"
	local tmp
	tmp=$(mktemp "$OUT_DIR/.env.XXXXXX")
	{
		printf '%s' "$data" | jq -r --arg q "'" 'to_entries[] | select(.key | startswith("VAULT_") | not) | .key + "=" + $q + (.value|tostring) + $q'
		printf "VAULT_ADDR='%s'\nVAULT_ROLE_ID='%s'\nVAULT_KV_PATH='%s'\n" "$VAULT_ADDR" "$role_id" "$mount/data/$rest"
		[ -z "$ca_line" ] || printf '%s\n' "$ca_line"
	} >"$tmp"
	chown "$DEPLOY_USER" "$tmp"
	chmod 0400 "$tmp"
	mv -f "$tmp" "$OUT_DIR/env"
	echo "rendered $OUT_DIR/env ($(wc -l <"$OUT_DIR/env") keys) and $SEC_DIR/vault_secret_id"
}

status() {
	echo "secret_id: $CRED ($([ -r "$CRED" ] && echo present || echo missing)), key: $CREDS_KEY"
	echo "tpm2: $(systemd-analyze has-tpm2 2>/dev/null | head -1 || echo unknown)"
	[ -r "$SEC_DIR/vault_secret_id" ] && echo "runtime: $SEC_DIR/vault_secret_id ($(stat -c '%a %u' "$SEC_DIR/vault_secret_id"))"
	return 0
}

case ${1:-} in
accept) accept ;;
render) render ;;
status) status ;;
*) die "usage: $0 accept|render|status" ;;
esac
